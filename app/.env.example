# IAM Career Lab — Environment Configuration
# Copy this file to .env and adjust as needed.
# NEVER commit the .env file or place secret values in this template.

# Ollama tutor endpoint (local default)
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model for the tutor
OLLAMA_MODEL=llama3.1

# Lab domain (do not use for public DNS)
LAB_DOMAIN=lab.local

# Lab DNS server (DC01)
LAB_DNS_SERVER=10.10.10.10

# Authorized IAM tenant/client IDs — only if legitimately needed
# AUTHORIZED_IAM_TENANT_ID=
# AUTHORIZED_IAM_CLIENT_ID=
